# Copy to .env (project root) and adjust. All values are optional for local demos.

# Database: SQLite file by default. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://aicte:aicte@localhost:5432/aicte

# Authentication
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=480
# DEMO_MODE shows demo officer accounts + password on the login screen. Set false for real use.
DEMO_MODE=true
DEMO_PASSWORD=Aicte@2026

# Machine-to-machine intake API (header X-API-Key). Leave empty to disable.
INTAKE_API_KEY=

# Background SLA monitor
SLA_MONITOR_ENABLED=true
SLA_SCAN_INTERVAL_MINUTES=15

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
